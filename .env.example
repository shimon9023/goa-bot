# ========================================
#  משתני סביבה של בוט GOA
#  אל תמלא את הקובץ הזה. הוא רק דוגמה.
#  את הערכים האמיתיים מדביקים בהגדרות של Render.
# ========================================

# --- טלגרם ---
# הטוקן שקיבלת מ-BotFather
TELEGRAM_BOT_TOKEN=
# מחרוזת סודית שאתה ממציא. מגינה על הכתובת שטלגרם פונה אליה.
TELEGRAM_WEBHOOK_SECRET=
# מזהי המשתמשים שמורשים להשתמש בבוט, מופרדים בפסיק. שלך ראשון.
TELEGRAM_ALLOWED_USER_IDS=
# המזהה שלך, לקבלת התראות מערכת
TELEGRAM_OWNER_ID=

# --- ווקומרס ---
WOO_SITE_URL=https://goasmoke.co.il
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# --- סופהבייס ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- בינה מלאכותית ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- כתובת ציבורית של השרת ---
# Render ייתן לך אותה אחרי הפריסה הראשונה
PUBLIC_BASE_URL=

# --- הגדרות ברירת מחדל (אפשר לשנות אחר כך מתוך הבוט) ---
PORT=3000
TZ=Asia/Jerusalem
